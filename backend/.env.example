# ── Shared ────────────────────────────────────────────────────────────
NODE_ENV=development

# ── MongoDB ───────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/darkline

# ── Redis (presence cache, cross-instance pub/sub, rate limiting) ────
REDIS_URL=redis://localhost:6379

# ── Kafka (event backbone — messages.new, presence.updates, calls.events)
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=darkline-backend

# ── Auth ──────────────────────────────────────────────────────────────
JWT_SECRET=change-me-dev-only
JWT_REFRESH_SECRET=change-me-dev-only-too
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
GOOGLE_CLIENT_ID=

# ── coturn / WebRTC ───────────────────────────────────────────────────
# TURN_SECRET must match coturn's --static-auth-secret, or relayed calls
# fail to authenticate. docker-compose starts coturn with that flag.
TURN_URL=turn:localhost:3478
TURN_SECRET=change-me-dev-only

# ── Outbound SMS — phone OTP (Twilio) ────────────────────────────────
# Leave blank in dev: the OTP is logged by the API and readable from Redis
# at `otp:<phone>` instead of being sent.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Outbound email — verification + password reset (SendGrid) ────────
# Leave blank in dev: codes/tokens are logged instead of sent.
SENDGRID_API_KEY=
MAIL_FROM=
# Base URL used to build password-reset links.
APP_BASE_URL=http://localhost:5173

# ── AWS (media storage) ──────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_S3_BUCKET=darkline-media-dev
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Firebase Cloud Messaging (push) ──────────────────────────────────
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# ── Per-service ports ─────────────────────────────────────────────────
API_PORT=4000
WS_SIGNALING_PORT=4001
